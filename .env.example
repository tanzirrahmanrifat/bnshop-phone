# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" (legacy) or "publishable" key — safe for the browser.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is also accepted instead of this name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" (legacy) or "secret" key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY is also accepted instead of this name.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, no trailing slash (used for login redirects, sitemap, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
